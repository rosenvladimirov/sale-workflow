<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_move_form_inherit_stock_int_picking" model="ir.ui.view">
        <field name="name">account.move.form.inherit.stock.int.picking</field>
        <field name="model">account.move</field>
        <field name="inherit_id" ref="account.view_move_form"/>
        <field name="arch" type="xml">
            <xpath expr="//notebook" position="inside">
                <page string="Internal Transfers" name="stock_int_picking" invisible="not stock_int_picking_ids">
                    <field name="stock_int_picking_ids" readonly="1">
                        <list>
                            <field name="name"/>
                            <field name="scheduled_date"/>
                            <field name="origin"/>
                            <field name="state"/>
                            <field name="partner_id"/>
                            <field name="location_id"/>
                            <field name="location_dest_id"/>
                        </list>
                    </field>
                </page>
            </xpath>
        </field>
    </record>
</odoo>
