<odoo>
    <record id="view_picking_cust_form" model="ir.ui.view">
        <field name="name">stock.picking.form</field>
        <field name="model">stock.picking</field>
        <field name="inherit_id" ref="stock.view_picking_form"/>
        <field name="arch" type="xml">
            <xpath expr="//notebook/page[@name='extra']/group" position="inside">
                <group string="Internal pickings incl. in sale">
                    <field name="int_picking_so_ids" widget="many2many_tags" options="{'open': True}" readonly="1"/>
                    <field name="stock_int_picking_ids" widget="many2many_tags" options="{'open': True}" readonly="1"/>
                </group>
            </xpath>
        </field>
    </record>
</odoo>
