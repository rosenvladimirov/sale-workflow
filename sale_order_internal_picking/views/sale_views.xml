<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_order_cust_form" model="ir.ui.view">
        <field name="name">sale.order.form</field>
        <field name="model">sale.order</field>
        <field name="inherit_id" ref="sale.view_order_form"/>
        <field name="arch" type="xml">
            <xpath expr="//page[@name='other_information']" position="inside">
                <field name="int_delivery_count" invisible="1"/>
                <group string="Internal pickings">
                    <field name="stock_int_picking_ids" widget="many2many_tags" options="{'open': True}"/>
                </group>
            </xpath>
            <field name="product_id" position="after">
                <field name="order_partner_id" invisible="1"/>
                <field name="order_partner_shipping_id" invisible="1"/>
                <field name="stock_int_picking_ids"
                       widget="many2many_tags"
                       optional="hide"
                       domain="[('picking_type_code', '=', 'internal'), '|', '|', ('partner_id', 'in', [order_partner_id, order_partner_shipping_id]), ('location_id.out_partner_id', 'in', [order_partner_id, order_partner_shipping_id]), ('location_dest_id.out_partner_id', 'in', [order_partner_id, order_partner_shipping_id])]"/>
            </field>
        </field>
    </record>
</odoo>
