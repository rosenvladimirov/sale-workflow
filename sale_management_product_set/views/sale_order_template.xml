<?xml version="1.0" encoding="UTF-8" ?>
<odoo>
    <record model="ir.ui.view" id="sale_order_template_view_form">
        <field name="name">sale.order.template.form.inherit</field>
        <field name="model">sale.order.template</field>
        <field name="inherit_id" ref="sale_management.sale_order_template_view_form" />
        <field name="arch" type="xml">
            <xpath expr="//list" position="inside">
                <control>
                    <button name="%(act_open_wizard_product_set_add_to_template)d"
                            class="btn-link"
                            type="action"
                            string="Add set"
                            context="{'default_order_id': parent.id, 'active_id': parent.id, 'active_model': 'sale.order.template'}"/>
                </control>
            </xpath>
            <xpath expr="//notebook" position="inside">
                <page string="Product sets" name="product_sets" invisible="not product_set_ids">
                    <div class="o_row">
                        <button name="action_set_sections" type="object"
                                string="Update set sections"
                                help="Re-order sections for set in lines"
                                class="btn-link mb-1 px-0" icon="fa-refresh"
                                confirm="This will update all sequences in lines and recreate the sections."
                                invisible="not product_set_ids"
                        />
                    </div>
                    <field name="product_set_ids" mode="list">
                        <list>
                            <field name="sale_order_template_id" invisible="1"/>
                            <field name="product_set_id"/>
                            <field name="quantity"/>
                        </list>
                    </field>
                </page>
            </xpath>
            <xpath expr="//field[@name='sale_order_template_line_ids']/list" position="inside">
                <field name="product_set_id"
                       options='{"no_create": True}'
                       optional="hide"/>
                <field name="product_set_line_id"
                       optional="hide"
                       context="{'search_default_product_set_id': product_set_id, 'default_product_set_id': product_set_id}"/>
                <field name="product_set_qty" invisible="1"/>
                <field name="product_set_price_subtotal" invisible="1"/>
            </xpath>
        </field>
    </record>
</odoo>
